# =====================================================================
# جُودِكس — متغيرات البيئة (انسخ هذا الملف إلى .env.local محليًا)
# لا تضع أي سر حقيقي في المستودع. في الإنتاج تُضبط من مدير الأسرار في منصة الاستضافة.
# =====================================================================

# ---- Supabase (الخلفية الوحيدة: Postgres + Auth + Storage) ----
# محليًا: تظهر القيم بعد `npx supabase start` (API URL و anon key و service_role key)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# سري: يُستخدم في الخادم والسكربتات فقط ولا يصل للمتصفح إطلاقًا
SUPABASE_SERVICE_ROLE_KEY=
# اتصال مباشر بقاعدة البيانات (للترحيلات عبر supabase CLI فقط؛ التطبيق لا يحتاجه)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- التطبيق ----
# نطاق لوحة الإدارة وواجهات الموظفين
APP_BASE_URL=http://localhost:3000
# نطاق رابط التقييم العام المطبوع في رموز QR (قد يختلف عن نطاق الإدارة)
PUBLIC_APP_URL=http://localhost:3000
# سر عشوائي ≥ 32 حرفًا (لتجزئة معرّف جهاز المستفيد HMAC). مثال للتوليد: openssl rand -base64 48
APP_SECRET=
# سر نقطة /api/cron/tick (اختياري — بديل pg_cron عبر مجدول خارجي). openssl rand -hex 32
CRON_SECRET=
# نطاق البريد الداخلي غير الظاهر لحسابات Supabase Auth (الدخول باسم المستخدم فقط)
AUTH_EMAIL_DOMAIN=jodex.local
# المنطقة الزمنية (القواعد تُحسب دائمًا بتوقيت Asia/Riyadh بغض النظر عن هذا المتغير)
TZ=Asia/Riyadh
# عدد الوكلاء العكسيين الموثوقين أمام التطبيق (لقراءة IP العميل لتحديد المعدل). 0 إن لم يوجد وكيل
TRUSTED_PROXY_HOPS=1

# ---- العرض التجريبي ----
# true يعرض قائمة الحسابات التجريبية في صفحة الدخول (بدون كلمات مرور). ممنوع في الإنتاج.
DEMO_MODE=false

# ---- تقارير PDF ----
# مسار Chromium لتوليد PDF عبر Playwright (اتركه فارغًا لاستخدام متصفح Playwright المثبت)
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# ---- للاختبارات الآلية فقط (لا تضبطها في الإنتاج إطلاقًا) ----
# ساعة الاختبار: تسمح بتثبيت «وقت الخادم» عبر ترويسة x-jodex-test-now مع السر
# JODEX_ALLOW_TEST_CLOCK=false
# JODEX_TEST_CLOCK_SECRET=
# السماح بكوكيز غير Secure عبر http المحلي عند تشغيل بناء الإنتاج محليًا
# JODEX_ALLOW_INSECURE_HTTP=false
