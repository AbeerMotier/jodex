{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "جُودِكس: تشغيل التطوير (npm run dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://\\S+)",
        "uriFormat": "%s/login",
        "action": "openExternally"
